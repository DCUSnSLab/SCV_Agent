# FTA 로봇별 프로비저닝 환경 파일 예시 (FR-6.2)
# /etc/fta/fta.env 로 복사 후 로봇별 값 설정. 저장소에 실제 값 커밋 금지 (NFR-5.3).
ROBOT_ID=r01
FTA_CONFIG=/opt/fta/config/fta.yaml
ROS_DOMAIN_ID=0

# MQTT 인증 (로봇별 개별 크리덴셜 — 유출 시 개별 폐기, NFR-5.2)
FTA_MQTT_USERNAME=robot-r01
FTA_MQTT_PASSWORD=CHANGE_ME

# DiskBuffer/감사 로그 경로 설정에서 참조 가능
FTA_BUFFER_DIR=/var/lib/fta/buffer
FTA_AUDIT_LOG=/var/lib/fta/audit.jsonl
